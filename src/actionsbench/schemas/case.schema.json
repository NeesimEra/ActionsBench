{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionsBench case",
  "description": "Metadata for one labeled corpus case (case.yaml). The case directory is a fake repository root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "is_negative",
    "expected",
    "rationale",
    "references",
    "provenance",
    "status",
    "author",
    "reviewer",
    "added_in"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AB-(ART|CTL|PRM|RUN|HRD|INJ|KVC|TRG|SEC|PIN|NEG)-[0-9]{4}$"
    },
    "title": { "type": "string", "minLength": 3 },
    "is_negative": { "type": "boolean" },
    "expected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["weakness_class", "file", "line", "evidence"],
        "properties": {
          "weakness_class": {
            "enum": [
              "artifact-integrity",
              "control-flow",
              "excessive-permission",
              "runner-compatibility",
              "hardening-gap",
              "injection",
              "known-vulnerable-component",
              "privileged-trigger",
              "secrets-exposure",
              "unpinned-dependency"
            ]
          },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 20 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https?://" }
    },
    "provenance": { "enum": ["synthetic-minimal", "derived-from-advisory"] },
    "status": { "enum": ["proposed", "ai-reviewed", "agreed", "disputed"] },
    "author": { "type": "string", "minLength": 1 },
    "reviewer": { "type": ["string", "null"] },
    "added_in": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "notes": { "type": "string" },
    "review_record": {
      "description": "Repository-relative path or URL to the dated review evidence and disposition. Required for ai-reviewed labels; not a claim of independent human review.",
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ai-reviewed" } }, "required": ["status"] },
      "then": {
        "required": ["review_record"],
        "properties": { "reviewer": { "type": "string", "pattern": "^ai:.+" } }
      }
    }
  ]
}
